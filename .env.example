MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_RELAYER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=ledgermind
TATUM_API_KEY=
# Optional. 64-char hex or suiprivkey1… Fund this wallet on Sui testnet.
# The anchor client uses testnet gRPC. It does not spend Mainnet gas.
SUI_PRIVATE_KEY=
SUI_GRPC_URL=https://fullnode.testnet.sui.io:443
# Set after npm run publish:anchor (optional — publish script writes data/sui-anchor-package.json)
SUI_ANCHOR_PACKAGE_ID=
RECEIPT_PROXY_SECRET_HEX=
# Optional: comma-separated mainnet blob IDs for public memory page when API cannot list
PUBLIC_MEMORY_BLOB_IDS=
